-- Primary Auto Clicker Engine
task.spawn(function()
	local counter = 2000
	while screenGui and screenGui.Parent do
		if autoClicking then
			local activeDelay = turboMode and 0.001 or clickDelay
			local inset = GuiService:GetGuiInset()
			local clickX = targetX
			local clickY = targetY + inset.Y

			counter = counter + 1
			local currentTouchId = counter

			pcall(function()
				VirtualInputManager:SendTouchEvent(currentTouchId, Enum.UserInputState.Begin.Value, clickX, clickY)
				VirtualInputManager:SendTouchEvent(currentTouchId, Enum.UserInputState.End.Value, clickX, clickY)
			end)
			
			if activeDelay > 0.01 then
				task.wait(activeDelay)
			else
				task.wait()
			end
		else
			task.wait(0.1)
		end
	end
end)

